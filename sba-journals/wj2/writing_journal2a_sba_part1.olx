<!-- Writing Journal 3a: The Group Chat — ENGL 1010 SBA -->
<Vertical id="wj2a_sba_root">

<!--
---
description: "Writing Journal 3a: How Do You Really Feel About Writing? — the group chat. The first half of the second journal in a first-year ENGL 1010 unit on writer identity. It opens in a phone group chat where three Writers' Circle peers argue about whether writer's block is real — the hook for the threshold concept that writing is shaped by identity and prior experience, not a fixed 'born writer' trait. A peer shares a playful writing-attitudes quiz; the Circle's tool plots the student on three attitude continuums (Expression–Evaluation, Growth–Performance, Engagement–Avoidance), and the student weighs the placement against their own sense of themselves. It ends with the Circle agreeing to finish the conversation in person, which is Writing Journal 3b."
category: writing_journal2
index: 92
lang: en-Latn-US
---
-->

<Cast cast="characters.cast" id="wj2a_sba_part1"
      title="Writing Journal 3a: The Group Chat"
      launchable="true">
  <Tabs id="wj2a_sba_tabs">

    <!-- Tab 1: the phone group chat — two panes, chat left, the current activity right.
         The conversation runs from the welcome screen through the quiz, the results, and
         the placement reflection, and ends by sending the student to the in-person
         meeting (Writing Journal 3b). The chat makes that jump itself: its last set
         command repoints the enclosing Course at wj2b_sba_part1. -->
    <Vertical id="wj2_circle_tab" title="The Circle">

      <!-- Attention cues. The TA reported that students didn't notice the right pane
           changing and didn't know where to look, so every screen the chat opens gets
           a pulse (Flash) as it lands, and the screens with something to fill in also
           get the caret (FocusAction) — which scrolls the control into view for free.
           Reading screens get the pulse alone. The chat points at them in dialogue
           instead (the lead-in lines beside each target embed in the chatpeg) and
           gates on their Done control, and the caret is deliberately NOT parked on
           that Done: it's the thing you press after reading, not before.

           The chat drives this pane with target embeds — `::wj2_survey
           [display=target:wj2_sidebar label="..."]` — rather than bare set arrows, so
           each activity also leaves a clickable marker in the transcript at the point
           it came up. That writes the QUALIFIED ref into @wj2_sidebar.value (arrows
           wrote the bare name), so every watch expression below normalizes both
           sides with DefinitionKey(...). A marker click re-writes the value, so it
           re-fires its cue (mode="each") just like a fresh arrival.

           These live HERE, outside the SplitPanel, and NOT inside the screens. A
           Trigger's prevValue is persisted component state; a Trigger mounted inside a
           UseHistory screen is unmounted the moment the pane moves on, so it never
           observes its own expression go false and never re-fires. Mounted out here it
           stays alive for the whole session, so mode="each" means each visit.

           FocusAction aims at the specific control, not the screen, so that a later
           edit reordering a screen can't silently move the caret somewhere useless. -->

      <!-- HACK: the DefinitionKey(...) normalization in these watch expressions is
           NOT long-term stable and should NOT be copied into other courses. It papers
           over the arrow-era assumption that pane values are bare screen names; target
           embeds write qualified refs. The intended fix is cues riding the embed itself
           (flash=/focus= on the ::screen [display=target:...] line) so no pane-value
           comparison exists at all — see bugs.md. We ship this and clean up later. -->
      <Trigger id="wj2_welcome_cue"       watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_welcome')"       mode="each">
        <Flash id="wj2_welcome_flash"       target="wj2_welcome" />
      </Trigger>

      <Trigger id="wj2_debate_react_cue"  watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_debate_react')"  mode="each">
        <Flash id="wj2_debate_react_flash"  target="wj2_block_take" />
        <FocusAction id="wj2_debate_react_focus" target="wj2_block_take" />
      </Trigger>

      <!-- The quiz is one statement at a time and the later items are when-gated out of
           the DOM entirely, so the caret goes to statement 1 by name. -->
      <Trigger id="wj2_survey_cue"        watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_survey')"        mode="each">
        <Flash id="wj2_survey_flash"        target="s01" />
        <FocusAction id="wj2_survey_focus"  target="s01" />
      </Trigger>

      <!-- The three ranking sets get the pulse only. SortableInput is drag-only — its
           items carry no tabindex and no handle button — so the sole focusable thing on
           these screens is the Submit button, and parking the caret there invites an
           Enter keypress that submits the default order. -->
      <Trigger id="wj2_good_1_cue"        watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_good_1_screen')" mode="each">
        <Flash id="wj2_good_1_flash"        target="wj2_good_1" />
      </Trigger>

      <Trigger id="wj2_good_2_cue"        watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_good_2_screen')" mode="each">
        <Flash id="wj2_good_2_flash"        target="wj2_good_2" />
      </Trigger>

      <Trigger id="wj2_good_3_cue"        watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_good_3_screen')" mode="each">
        <Flash id="wj2_good_3_flash"        target="wj2_good_3" />
      </Trigger>

      <Trigger id="wj2_vibe_explainer_cue" watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_vibe_explainer')" mode="each">
        <Flash id="wj2_vibe_explainer_flash" target="wj2_vibe_explainer" />
      </Trigger>

      <Trigger id="wj2_results_cue"       watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_results')"       mode="each">
        <Flash id="wj2_results_flash"       target="wj2_results_btn" />
        <FocusAction id="wj2_results_focus" target="wj2_results_btn" />
      </Trigger>

      <!-- Pulse only: the reflection TextArea for this step is embedded in the CHAT
           (::wj2_placement_input), not in the pane, so the only focusable thing on the
           screen is the "Show my results again" collapsible toggle. -->
      <Trigger id="wj2_placement_reflect_cue" watch="DefinitionKey(@wj2_sidebar.value) === DefinitionKey('wj2_placement_reflect')" mode="each">
        <Flash id="wj2_placement_reflect_flash" target="wj2_placement_reflect" />
      </Trigger>

      <!-- wj2_blank gets no cue on purpose: the point of that screen is that the pane
           has gone quiet, and there is nothing on it to look at. -->

      <SplitPanel id="wj2_sba_split" sizes="38, 62">
        <LeftPane>
          <Chat id="wj2_chat"
                src="writing_journal2_dialogue_part1.chatpeg"
                height="460px" />
        </LeftPane>
        <RightPane>
          <Vertical id="wj2_current_activity" title="Current Activity">
            <UseHistory id="wj2_sidebar" initial="wj2_welcome" />
          </Vertical>
        </RightPane>
      </SplitPanel>
    </Vertical>

    <!-- Tab 2: the running record of the student's work -->
    <Vertical id="wj2_journal_tab" title="My Journal">
      <Use ref="wj2_artifact" />
    </Vertical>

    <!-- Tab 3: the people in the Circle -->
    <Vertical id="wj2_people_tab" title="Characters">
      <Use ref="wj2_circle_members" />
    </Vertical>

  </Tabs>
</Cast>

<!-- ============================================================
     REFERENCED CONTENT BLOCKS
     Defined here and shared with Writing Journal 3b, which refers to
     both of them by bare ref (one namespace across sba-journals/).
     ============================================================ -->

<!-- Who's in the group chat / Circle (reads the cast) -->
<TeamDirectory id="wj2_circle_members" title="Characters"/>

<!-- Pull in the running-record artifact -->
<Use ref="wj2_artifact" src="artifact.olx"/>

</Vertical>
