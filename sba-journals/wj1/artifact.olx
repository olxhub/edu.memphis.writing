<!-- My Writing Journal (running artifact) for Writing Journal 1 -->
<Vertical id="wj1_artifact">

  <Markdown id="wj1_artifact_intro">
## My Writing Journal — Entry 1

This tab gathers your work in one place as you go, so you can see the whole journal at a glance — your
Writer Board, why you write what you write, the writer type you chose, and your reflection on it. Come
back any time to review what you've built.

*Submitting is handled on the **Print &amp; Submit** tab — that's where you'll confirm you're done and
export your PDF.*
  </Markdown>

  <Collapsible id="wj1_artifact_board" title="1. My Writer Board">
    <IntakeGate ready="@wj1_board_ready.value === 'go'">
      <Markdown>*Your board will appear here once you've built it over in **The Circle**.*</Markdown>
      <Vertical id="wj1_art_board_inner">
        <Markdown>**🏫 For school** — how often I do each kind of writing:</Markdown>
        <Use ref="wj1_board_school" />
        <Markdown>**Also, for school:**</Markdown>
        <Ref id="wj1_art_board_school_other" target="wj1_board_school_other" />
        <Markdown>**🌙 Outside school** — how often I do each kind:</Markdown>
        <Use ref="wj1_board_outside" />
        <Markdown>**Also, outside school:**</Markdown>
        <Ref id="wj1_art_board_outside_other" target="wj1_board_outside_other" />
        <Markdown>**Something I almost didn't count as writing:**</Markdown>
        <Ref id="wj1_art_noticing" target="wj1_board_noticing_text" />
      </Vertical>
    </IntakeGate>
  </Collapsible>

  <Collapsible id="wj1_artifact_why" title="2. Why I write">
    <!-- <Use>, not <Ref>: a Ref renders the stored value, which is a code like
         `figure_out`; <Use> re-renders the dropdown, showing the sentence.
         Each group can also carry a "Something else" description; it shows here
         only when that group's dropdown is on `something_else`. The gate has to
         be repeated here — a <Use> of the activity's gated Vertical would drop it. -->
    <Markdown>**Messaging &amp; staying in touch:**</Markdown>
    <Use ref="wj1_why_messaging" />
    <Vertical id="wj1_art_why_msg_other_box" when="@wj1_why_messaging.value === 'something_else'">
      <Markdown>*In my own words:*</Markdown>
      <Ref id="wj1_art_why_msg_other" target="wj1_why_messaging_other" />
    </Vertical>
    <Markdown>**Coursework &amp; class writing:**</Markdown>
    <Use ref="wj1_why_coursework" />
    <Vertical id="wj1_art_why_course_other_box" when="@wj1_why_coursework.value === 'something_else'">
      <Markdown>*In my own words:*</Markdown>
      <Ref id="wj1_art_why_course_other" target="wj1_why_coursework_other" />
    </Vertical>
    <Markdown>**Notes, lists &amp; organizing:**</Markdown>
    <Use ref="wj1_why_organizing" />
    <Vertical id="wj1_art_why_org_other_box" when="@wj1_why_organizing.value === 'something_else'">
      <Markdown>*In my own words:*</Markdown>
      <Ref id="wj1_art_why_org_other" target="wj1_why_organizing_other" />
    </Vertical>
    <Markdown>**Posting &amp; sharing publicly:**</Markdown>
    <Use ref="wj1_why_posting" />
    <Vertical id="wj1_art_why_post_other_box" when="@wj1_why_posting.value === 'something_else'">
      <Markdown>*In my own words:*</Markdown>
      <Ref id="wj1_art_why_post_other" target="wj1_why_posting_other" />
    </Vertical>
    <Markdown>**Creative &amp; personal writing:**</Markdown>
    <Use ref="wj1_why_creative" />
    <Vertical id="wj1_art_why_creative_other_box" when="@wj1_why_creative.value === 'something_else'">
      <Markdown>*In my own words:*</Markdown>
      <Ref id="wj1_art_why_creative_other" target="wj1_why_creative_other" />
    </Vertical>
    <Markdown>**What surprised me:**</Markdown>
    <Ref id="wj1_art_why_reflect" target="wj1_why_reflect" />
  </Collapsible>

  <Collapsible id="wj1_artifact_profile" title="3. My writer type">
    <!-- The card the student CHOSE, by reference. wj1_type_result carries both
         the choice in words and the card itself, and its per-type gates mount
         exactly one branch, so this is always their card and only theirs. The
         "Does this feel like me?" question that used to sit here (wj1_fit) went
         away when the type stopped being assigned — see the Task 3 comment in
         writing_journal1_activities_part1.olx. -->
    <Markdown>*You chose this one over on **The Circle** tab. Head back there to browse the deck again if you want to change it.*</Markdown>
    <Use ref="wj1_type_result" />
  </Collapsible>

  <Collapsible id="wj1_artifact_reflect" title="4. My reflection — a story from my writing life">
    <Ref id="wj1_art_profile_reflect" target="wj1_profile_reflect" />
  </Collapsible>

</Vertical>
