<!-- Top-level wrapper tying the SBA Writing Journals into one course.

     The journals themselves live in wj1/ and wj2/; this file only
     sequences them. The refs are bare (no namespace prefix): everything
     under sba-journals/ parses as the one namespace declared in
     manifest.yaml.

     Writing Journal 3 is one part: the group chat carries the whole
     journal, and its last beat opens the journal's own Print & Submit tab.
     The earlier two-part version (wj2a/wj2b) stays in the repository for
     comparison at its review routes and is not in the nav. The nav labels
     come from each journal's own title= attribute. -->

<Course id="wj_course" title="Writing Journals" launchable="course">
  <!-- The journals join the nav when the tutorial hands off (it sets
       tut_complete on its final beat) — until then the course is the
       tutorial, and there is nothing to wander into half-taught. -->
  <Use ref="tut_sba_part1" />
  <Use ref="wj1_sba_part1"  when="@tut_complete.value" />
  <Use ref="wj3_sba" when="@tut_complete.value" />
  <!-- Same block the consent gate shows; same state. Here so a student can
       revisit and change their answer at any time (consent.olx). -->
  <Use ref="wj_irb_consent_form" />
</Course>
